# ==============================================================================
# REBUILD AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real production passwords or secret keys to public Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security & JWT Token Generation
# Generate a secure 32+ byte string in production: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-environment
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# Local Development: SQLite
DATABASE_URL=sqlite:///./rebuild_ai.db
# Production: PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/rebuild_ai

# CORS Allowed Origins (comma-separated, e.g. http://localhost:5173,https://your-domain.com)
CORS_ORIGINS=*

# Local Development Seed Accounts (Only populated during first database initialization)
ADMIN_EMAIL=admin@rebuildai.com
ADMIN_PASSWORD=Admin@1234
SELLER_EMAIL=seller@demolitioncorp.com
SELLER_PASSWORD=Seller@1234
BUYER_EMAIL=buyer@greenbuild.in
BUYER_PASSWORD=Buyer@1234
